 "input_descriptions": {
  "inputs:compact-memory/mods-2020-06-15": {
   "title": "Compact Memory metadata export of UB Frankfurt (MODS records and page table)",
   "origin": "Export of the Visual Library of UB Frankfurt of 2020-06-15, received from UB Frankfurt; kept in the repository of the FID portal (wagtail-common-base, site/portal/judaicalink/sources/, commit ea89ebf3).",
   "description": "Zip with two files: CM_Knoten_MODS_XML_15.06.2020, the MODS records of all nodes of Compact Memory (journals, volumes, issues, articles; 64 MB of XML), and CM_Seiten_Metadaten_15.06.2020.xlsx, the page table (its CSV conversion is the file of compact-memory-supp).",
   "date": "2020-06-15",
   "note": "Not published: 51 MB, needed only to make datasets."
  },
  "inputs:compact-memory/ocr-paths-2026-10-05": {
   "title": "List of the Compact Memory OCR files",
   "origin": "Listing of the OCR XML files of Compact Memory on the JudaicaLink labs server in Mannheim (find -name '*.xml' in the XML folder), 2026-10-05.",
   "description": "Gzipped text, one path per line (856,043 lines), relative to the XML folder: <journal>/<volume>/<issue>/<file prefix>_<page VLID>.xml. The page IRIs of compact-memory are built from these paths: <journal>-<volume>-<issue>--<file prefix>-<page VLID>.",
   "date": "2026-10-05",
   "note": "The OCR files themselves (about 1 TB) are not kept here."
  },
  "inputs:compact-memory/fulltext-2026-10-05-v2": {
   "title": "Compact Memory full text for the Solr core cm_meta (bundle v2)",
   "origin": "Made on 2026-10-05 by extract_cm_fulltext.py (cm_indexer in the repository of the FID portal, handed over to Frankfurt) from the OCR XML files of Compact Memory on the JudaicaLink labs server in Mannheim, the page table (compact-memory-supp) and the MODS records (inputs:compact-memory/mods-2020-06-15); a copy is on that server.",
   "description": "846,500 pages of Compact Memory as documents for the Solr core cm_meta, one JSON object per line in 35 gzipped parts (docs-NNNN.jsonl.gz): page VLID, journal, date of issue, page label, volume, OCR text. manifest.json lists the parts with their checksums, the pages left out (no OCR file, no metadata, no text) and the corrections (Hebrew calendar years converted to Gregorian, which can be one year off; '(null)' removed; volumes rebuilt from the MODS records). date_review.tsv lists 513 pages whose year is isolated from the rest of their journal (not changed). The bundle also holds its README.md, the scripts that made and corrected it (extract_cm_fulltext.py, fix_bundle.py with fix_bundle.log), the loader for Solr (load_cm_fulltext.py) and dropped.tsv.gz (the pages left out, with the reason).",
   "date": "2026-10-05",
   "note": "Not published: 2 GB of OCR full text, needed only to make datasets; the full-text search of the FID portal is built from it."
  }
 },
